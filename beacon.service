[Unit]
Description=Beacon - Minecraft server admin dashboard (LAN-only)
After=network.target mc-ultimaterealm.service

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/beacon
# BEACON_HOST (the LAN address to bind) comes from the untracked .env on the box
EnvironmentFile=/opt/beacon/.env
ExecStart=/opt/beacon/.venv/bin/python3 -m uvicorn app.main:app --host ${BEACON_HOST} --port 8090
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
