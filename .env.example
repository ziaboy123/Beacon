# Beacon runs locally on the Minecraft box (LXC 200) and talks to the
# server over localhost RCON, plus direct filesystem access.

# Reuse the same RCON credentials already enabled for Arc in server.properties
# (rcon.port / rcon.password) — no new secret needed since this runs locally.
BEACON_RCON_HOST=127.0.0.1
BEACON_RCON_PORT=25575
BEACON_RCON_PASSWORD=

# Directory containing server.properties, whitelist.json, ops.json, usercache.json
BEACON_MC_SERVER_DIR=/opt/minecraft

# systemd unit name for the Minecraft server (for uptime + journalctl console tail)
BEACON_SYSTEMD_UNIT=mc-ultimaterealm.service

# Bind address/port for Beacon itself. Bind to the LAN address (not 0.0.0.0)
# so it's LAN-reachable but not accidentally exposed if the box ever gets a
# WAN-facing interface added later.
BEACON_HOST=10.68.5.243
BEACON_PORT=8090
